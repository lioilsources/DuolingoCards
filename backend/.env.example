# Server configuration
PORT=8080

# ElevenLabs API key for TTS
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google API key for Imagen 3
# Get from: https://console.cloud.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Storage configuration
STORAGE_PATH=./media
STORAGE_BASE_URL=http://localhost:8080/media

# Image generation backend: "imagen" (default) or "comfyui"
IMAGE_BACKEND=imagen

# ComfyUI server URL (required when IMAGE_BACKEND=comfyui)
COMFYUI_API_URL=http://localhost:8188

# Cloudflare Access service token (optional, only needed if ComfyUI is behind CF Access)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ComfyUI job timeout (default: 15m)
# COMFYUI_JOB_TIMEOUT=15m
