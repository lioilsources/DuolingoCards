# Copy to .env. Never commit .env. Placeholders only: no LAN addresses, no real values.
# The Makefile defaults SPARK_LLM / SPARK_IMG with `?=`, so exported values win:
#   set -a; . ./.env; set +a; make translate DECK=animals-sea
SPARK_LLM=http://spark.example:8080
SPARK_IMG=http://spark.example:8188
