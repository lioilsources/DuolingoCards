  - key: emotion.bored
    hint: feeling uninterested and lacking stimulation, wanting something to happen
    image: emotion.bored.png
    brief:
      subject: bored cartoon child character
      attrs: [drooping eyelids, head resting on hand, flat mouth, restless expression]
      setting: [grey or muted background, simple, centered]
      avoid: [text, happy expression, exciting action, scary]

  - key: emotion.confused
    hint: feeling unable to understand something clearly, puzzled
    image: emotion.confused.png
    brief:
      subject: confused cartoon child character
      attrs: [tilted head, question mark above head, furrowed brow, one eyebrow up]
      setting: [light purple or grey background, simple, centered]
      avoid: [text, happy, angry, scary]

